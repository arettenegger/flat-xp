<div class="content narrow">
  <h1 class="page-title">Kontakt</h1>
  <hr class="fx-sep">
  <div class="contact">
    <div class="contact-info">
      <h3>FLAT-XP</h3>
      <p><strong><%= site.owner %></strong><br><%= site.address %></p>
      <p>Mobil: <a href="tel:<%= site.phoneLink %>"><%= site.phone %></a><br>
         E-Mail: <a href="mailto:<%= site.email %>"><%= site.email %></a></p>
    </div>
    <form class="contact-form" method="post" action="/kontakt.php">
      <label>Name *<input name="name" required maxlength="100" autocomplete="name"></label>
      <label>E-Mail *<input name="email" type="email" required maxlength="150" autocomplete="email"></label>
      <label>Telefon<input name="telefon" maxlength="50" autocomplete="tel"></label>
      <label>Betreff<input name="betreff" maxlength="150"></label>
      <label>Nachricht *<textarea name="nachricht" rows="7" required maxlength="5000"></textarea></label>
      <label class="hp" aria-hidden="true">Bitte leer lassen<input name="website" tabindex="-1" autocomplete="off"></label>
      <label class="check"><input type="checkbox" name="dsgvo" required> Ich bin damit einverstanden, dass meine Angaben zur Beantwortung meiner Anfrage verarbeitet werden. Details in der <a href="/datenschutz/">Datenschutzerklärung</a>.</label>
      <button class="fx-btn" type="submit">Nachricht senden</button>
    </form>
  </div>
</div>
