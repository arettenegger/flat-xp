# Flat-XP – statische Website (aus Node.js-Build), ausgeliefert von SiteGround

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # immer HTTPS und ohne www
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://flat-xp.at/$1 [R=301,L]

  # alte WordPress-Adressen weiterleiten (SEO, alte Links)
  RewriteRule ^wp-content/uploads/(.*)$ /uploads/$1 [R=301,L]
  RewriteRule ^Purpose/(.*)$ /$1 [R=301,L,NC]
  RewriteRule ^(feed|comments/feed)/?$ /blog/ [R=301,L]
  RewriteRule ^(author|category|tag)/.*$ /blog/ [R=301,L]
  RewriteRule ^galerien/[^/]+/?$ /galerien/ [R=301,L]
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-json) - [G,L]

  # fehlenden Schrägstrich am Ende ergänzen
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-z0-9]{2,5}$ [NC]
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Git-Dateien nie ausliefern
<FilesMatch "^\.git">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
